# Plantilla de variables de Comunicalo Learning.
# Copiar a infra/.env y llenar. El .env real NUNCA va a git.
# En A se crea directamente en el servidor y se guarda copia en el gestor de contraseñas.
# Sin comentarios al final de la línea en el .env real.

# --- Versiones fijas (decisión 0008). Etiquetas exactas, nunca ramas. ---
# FRAPPE_VERSION ej. v16.60.2 | LMS_VERSION ej. v16.3.0
# PAYMENTS_VERSION ej. v16.0.1 (commit 1978965f38b8a1f0ea30c5f5dfd1c37d4888afe3)
# FRAPPE_DOCKER_VERSION ej. v4.2.0 | PYTHON_VERSION ej. 3.14.10
# MARIADB_VERSION ej. 11.8.9 | REDIS_VERSION ej. 8.6.8-alpine
# IMAGEN_BASE ej. comunicalo/learning:f16.60.2-lms16.3.0-pay16.0.1 (Frappe + lms + payments)
# IMAGEN_LEARNING ej. comunicalo/learning:f16.60.2-lms16.3.0-pay16.0.1-auth0.1.0 (base + apps propias; la usa el compose)
FRAPPE_VERSION=
LMS_VERSION=
PAYMENTS_VERSION=
FRAPPE_DOCKER_VERSION=
PYTHON_VERSION=
MARIADB_VERSION=
REDIS_VERSION=
IMAGEN_BASE=
IMAGEN_LEARNING=

# --- Sitio ---
# SITE_NAME ej. elearning.grupocomunicalo.mx
SITE_NAME=
ADMIN_PASSWORD=

# --- Base de datos propia de Frappe (MariaDB). NO es la del ERP. ---
DB_ROOT_PASSWORD=

# --- Publicación: puerto en 127.0.0.1 del servidor (8080 lo usa Keycloak en A) ---
HTTP_PORT=8090
CLIENT_MAX_BODY_SIZE=200m

# --- Integración con el ERP (decisión 0005). Se copia al site_config con bench set-config. ---
# ERP_API_URL ej. https://grupocomunicalo.mx (sin /api)
ERP_API_URL=
ERP_TIMEOUT_SEGUNDOS=10

# --- Límites de memoria (dejar espacio al ERP si hace failover a A) ---
LIMITE_MEMORIA_BACKEND=1g
LIMITE_MEMORIA_WORKER=512m
LIMITE_MEMORIA_DB=768m
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
